<?xml version="1.0" encoding="utf-8"?>
<!--
    The key store is deliberately excluded from every backup: a backup of this
    app must never carry the tokens, whatever device it lands on.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="notes.json" />
        <exclude domain="sharedpref" path="muffy_git.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="notes.json" />
        <exclude domain="sharedpref" path="muffy_git.xml" />
    </device-transfer>
</data-extraction-rules>
