<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the notes file is ever backed up. The credential store (the
    muffy_git preferences) sits in no included path, so a backup of this app
    can never carry a token. That is deliberate, and lint keeps it honest.
-->
<full-backup-content>
    <include domain="file" path="notes.json" />
</full-backup-content>
